{
  "name": "aquascape-3d",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "eslint src",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "vitest run src/tests/offline-benchmark.test.ts --maxWorkers=1",
    "assets": "node scripts/generate-previews.mjs",
    "prebuild": "npm run assets",
    "assets:models": "blender --background --python tools/m1/build_assets.py && python3 tools/m1/pack_assets.py",
    "assets:validate": "node scripts/validate-models.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.4.0",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@types/node": "24.0.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.39.1",
    "fake-indexeddb": "6.2.6",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.1.0",
    "vitest": "3.2.7"
  }
}
